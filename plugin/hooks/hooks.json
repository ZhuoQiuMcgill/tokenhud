{
  "description": "Tells agents when a usage limit alert they set with tokenhud's set_alert tool fires",
  "hooks": {
    "PostToolBatch": [
      { "hooks": [{ "type": "command", "command": "tokenhud", "args": ["hook"], "timeout": 10 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "tokenhud", "args": ["hook"], "timeout": 10 }] }
    ],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "tokenhud", "args": ["hook"] }] }]
  }
}
