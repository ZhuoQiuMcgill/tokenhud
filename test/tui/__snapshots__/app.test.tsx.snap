exports[`states help overlay: how to move, this view's keys with its tab names, the global keys 1`] = `
" tokenhud   1 Overview   2 History   3 Models   4 Accounts            scope all accounts ▾   ● live · 5s 
─────────────────────────────────────────────────────────────────────────────────────────────────────────
                                                                                                         
     ╭─ Keys ───────────────────────────────────────────────────────────────────────────────────────╮    
     │  MOVE                                                                                        │    
     │   a/d  ←/→             Switch the tab: what the view shows                                   │    
     │   w/s  ↑/↓             Move the selection: which row or card                                 │    
     │   enter                Open the selection                                                    │    
     │   esc                  Go back one step: close, un-drill, clear                              │    
     │   WASD works like the arrow keys; letters work with Caps Lock on                             │    
     │                                                                                              │    
     │  HISTORY                                                                                     │    
     │   a/d                  Switch the table: this week · this month · days · weeks · months      │    
     │   w/s                  Select a row; the heat map highlights its day, week or month          │    
     │   pgup/pgdn  home/end  Move ten rows, or to the first or last                                │    
     │   enter                On a week or month, list its days; on a day, list its limit events    │    
     │   esc                  Close the limit events, then the open week or month, then clear the   │    
     │                        filter                                                                │    
     │   f  /                 Filter every number by model: type part of its name or id, enter      │    
     │                        applies it                                                            │    
     │                                                                                              │    
     │  GLOBAL                                                                                      │    
     │   1-4                  Switch view: Overview, History, Models, Accounts                      │    
     │   tab  shift-tab       Next view; shift-tab goes to the previous one                         │    
     │   c                    Cycle the account scope: all accounts, then each account, then all    │    
     │                        again                                                                 │    
     │   x                    Open settings                                                         │    
     │   ?                    Show the keys, this view's included                                   │    
     │   q  Ctrl-C            Quit                                                                  │    
     ╰──────────────────────────────────────────────────────────────────────────────────────────────╯    
                                                                                                         
                                                                                                         
                                                                                                         
                                                                                                         
                                                                                                         
                                                                                                         
                                                                                                         
                                                                                                         
                                                                                                         
                                                                                                         
                                                                                                         
                                                                                                         
                                                                                                         
                                                                                                         
                                                                                                         
                                                                                                         
                                                                                                         
─────────────────────────────────────────────────────────────────────────────────────────────────────────
 esc close                                                                                               
                                                                                          MCP ● 2 agents 
"
`;

