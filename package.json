{
  "name": "tokenhud",
  "version": "0.1.0",
  "private": true,
  "description": "Live terminal heads-up display for coding-agent usage, limits and cost",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "check": "bun run typecheck && bun run lint && bun run test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "bench:store": "bun test/store/bench.ts",
    "bench:query": "bun test/query/bench.ts",
    "bench:tui": "bun test/tui/bench.tsx",
    "parity": "bun scripts/parity.ts",
    "shots": "bun scripts/readme-shots.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "@opentui/core": "0.5.14",
    "@opentui/react": "0.5.14",
    "react": "19.3.0"
  }
}
